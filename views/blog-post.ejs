			<a href="/portfolio" data-i18n="nav.portfolio">Portfolio</a>
			<a href="/blog.html" class="is-active" data-i18n="nav.blog">Blog</a>
			<a href="/about.html" data-i18n="nav.about">Giới thiệu</a>
			<a href="/contact.html" data-i18n="nav.contact">Liên hệ</a>
		</nav>
		<div class="sidebar-bottom">
			<div class="lang-toggle" role="group" data-i18n-aria="lang.groupLabel" aria-label="Chọn ngôn ngữ">
				<button type="button" class="lang-btn is-active" data-lang="vi">VI</button>
				<button type="button" class="lang-btn" data-lang="en">EN</button>
