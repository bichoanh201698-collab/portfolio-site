				</a>
				<a href="mailto:shinetu.ds@gmail.com" aria-label="Email">
					<svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6zm-2 0-8 5-8-5h16zm0 12H4V8l8 5 8-5v10z"/></svg>
				</a>
			</div>
		</div>
	</aside>

	<div class="content">

		<section class="section-tight">
			<a href="/blog.html" class="detail-back" data-i18n-vi="← Quay lại Blog" data-i18n-en="← Back to Blog">← Quay lại Blog</a>

			<div class="card-tags" style="margin-top:1.5em;">
				<% if (post.tag_vi || post.tag_en) { %><span class="tag" data-i18n-vi="<%= post.tag_vi %>" data-i18n-en="<%= post.tag_en %>"><%= post.tag_vi %></span><% } %>
				<span class="post-date" data-i18n-vi="<%= post.date_display_vi %>" data-i18n-en="<%= post.date_display_en %>"><%= post.date_display_vi %></span>
			</div>

			<h1 data-i18n-vi="<%= post.title_vi %>" data-i18n-en="<%= post.title_en %>"><%= post.title_vi %></h1>
		</section>

		<img class="detail-image" src="<%= post.image %>" alt="">

		<section class="section-tight">

			<% if (blocks.length > 0) { %>
				<% blocks.forEach(function (b) { %>

					<% if (b.type === "text") { %>
						<p class="detail-content" data-i18n-vi="<%= b.text_vi %>" data-i18n-en="<%= b.text_en %>"><%= b.text_vi %></p>

					<% } else if (b.type === "image") { %>
						<figure class="detail-figure">
							<img class="detail-block-image" src="<%= b.src %>" alt="">
							<% if (b.caption_vi || b.caption_en) { %>
								<figcaption class="detail-caption" data-i18n-vi="<%= b.caption_vi %>" data-i18n-en="<%= b.caption_en %>"><%= b.caption_vi %></figcaption>
							<% } %>
						</figure>

					<% } else if (b.type === "video" && b.src) { %>
						<figure class="detail-figure">
							<% if (b.video.kind === "embed") { %>
								<div class="detail-video-wrapper">
									<iframe src="<%= b.video.embedUrl %>" title="video" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
								</div>
							<% } else { %>
								<video class="detail-block-video" src="<%= b.video.src %>" controls></video>
							<% } %>
							<% if (b.caption_vi || b.caption_en) { %>
								<figcaption class="detail-caption" data-i18n-vi="<%= b.caption_vi %>" data-i18n-en="<%= b.caption_en %>"><%= b.caption_vi %></figcaption>
							<% } %>
						</figure>
					<% } %>

				<% }); %>
			<% } else { %>
				<p class="detail-content" data-i18n-vi="<%= post.excerpt_vi %>" data-i18n-en="<%= post.excerpt_en %>"><%= post.excerpt_vi %></p>
			<% } %>

		</section>

		<footer class="site-footer">
			<div><strong data-i18n="footer.copyright">© 2026 Shine Tu</strong></div>
			<div data-i18n-html="footer.themeCredit">Thiết kế dựa trên theme <a href="https://andersnoren.se/themes/bjork/" target="_blank" rel="noopener">Björk</a> của Anders Norén</div>
		</footer>

	</div>
</div>

<script src="/js/main.js"></script>
</body>
</html>
